# 운영체제에서 자동으로 만드는 파일
.DS_Store
Thumbs.db
Desktop.ini

# 개인 편집기 설정과 임시 저장 파일
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# 개인 환경 변수 (공유용 예시 파일은 허용)
.env
.env.*
!.env.example

# 로컬 개발 도구 / 캐시
node_modules/
.cache/
__pycache__/
*.pyc
*.log

# 작업용 폴더와 배포용 압축본
/work/
/tmp/
/temp/
/outputs/
*.zip
*.7z
*.rar

# HTML, CSS, JS, assets, docs는 저장소에 포함합니다.
# 이미 Git에서 추적 중인 파일에는 ignore 규칙이 소급 적용되지 않습니다.
